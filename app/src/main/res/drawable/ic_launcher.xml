<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/drawable/ic_launcher.xml -->
<!-- НАЗНАЧЕНИЕ: иконка приложения на рабочем столе.
     ЗАЧЕМ ВЕКТОР: не нужен PNG-файл, работает на любых DPI.
     Стиль: тёмный фон + синий круг (в духе M&D). -->

<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Фон: тёмный квадрат -->
    <path
        android:fillColor="#0E1116"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Синий круг по центру (радиус 34) -->
    <path
        android:fillColor="#4F8CFF"
        android:pathData="M20,54 A34,34 0 1,1 88,54 A34,34 0 1,1 20,54 Z" />
</vector>
